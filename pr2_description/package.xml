<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>pr2_description</name>
  <version>2.0.0</version>
  
  <description>This package contains the description (mechanical, kinematic, visual,
  etc.) of the PR2 robot.  The files in this package are parsed and used by
  a variety of other components.  Most users will not interact directly
  with this package.</description>
  <maintainer email="gsarthou@laas.fr">LAAS-CNRS</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/pr2_description</url>
  <url type="bugtracker">https://github.com/PR2/pr2_common/issues</url>

  <author>John Hsu</author>
  <author>Eric Berger</author>
  <author>Austin Hendrix</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>convex_decomposition</depend>
  <depend>ivcon</depend>

  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>iburdfdom-dev</test_depend>
  <!-- <test_depend>urdfdom</test_depend> As of Indigo this is a system deb at liburdfdom-dev -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
