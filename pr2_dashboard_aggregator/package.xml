<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>pr2_dashboard_aggregator</name>
  <version>2.0.0</version>
  <description>A simple script that aggregates all of the topics that a "pr2_dashboard" app might be interested in.</description>
  <maintainer email="gsarthou@laas.fr">LAAS-CNRS</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/pr2_dashboard_aggregator</url>
  <url type="bugtracker">https://github.com/PR2/pr2_common/issues</url>

  <author>Rob Wheeler</author>
  <author>Austin Hendrix</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>pr2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
